+/*
+ * Runtime CPU detection for the 2stage kernel defaults (x86 only). This is a
+ * pure default: ELPA_FORCE_* env (checked in every get), an explicit set()
+ * after instance creation, and ELPA_DEFAULT_* env (consumed by the ALLOCATE
+ * loop of elpa_index_instance(), tracked via notified) all take precedence.
+ */
+#if defined(__x86_64__) || defined(__i386__)
+
+enum cpu_feature {
+        CPU_FEATURE_NONE,
+        CPU_FEATURE_SSE2,
+        CPU_FEATURE_AVX,
+        CPU_FEATURE_AVX2,
+        CPU_FEATURE_AVX512F,
+};
+
+/* __builtin_cpu_supports requires a string literal, so the probe tables carry
+   this enum instead of a feature string */
+static int cpu_feature_supported(enum cpu_feature feature) {
+        switch (feature) {
+                case CPU_FEATURE_SSE2:
+                        return __builtin_cpu_supports("sse2");
+                case CPU_FEATURE_AVX:
+                        return __builtin_cpu_supports("avx");
+                case CPU_FEATURE_AVX2:
+                        return __builtin_cpu_supports("avx2");
+                case CPU_FEATURE_AVX512F:
+                        return __builtin_cpu_supports("avx512f");
+                case CPU_FEATURE_NONE:
+                        return 1;
+        }
+        return 0;
+}
+
+struct kernel_probe {
+        int kernel;
+        enum cpu_feature cpu_feature;
+};
+
+#define COMPILED_CASE(name, value, compiled, ...) \
+        case value: \
+                return compiled;
+
+static int real_kernel_is_compiled(int kernel) {
+        switch (kernel) {
+                ELPA_FOR_ALL_2STAGE_REAL_KERNELS(COMPILED_CASE)
+                default:
+                        return 0;
+        }
+}
+
+static int complex_kernel_is_compiled(int kernel) {
+        switch (kernel) {
+                ELPA_FOR_ALL_2STAGE_COMPLEX_KERNELS(COMPILED_CASE)
+                default:
+                        return 0;
+        }
+}
+
+/* Order mirrors the default-kernel priority list of configure, restricted to
+   the x86 SIMD families plus the generic fallbacks */
+static const struct kernel_probe real_kernel_probe_order[] = {
+        { ELPA_2STAGE_REAL_AVX512_BLOCK2, CPU_FEATURE_AVX512F },
+        { ELPA_2STAGE_REAL_AVX512_BLOCK4, CPU_FEATURE_AVX512F },
+        { ELPA_2STAGE_REAL_AVX512_BLOCK6, CPU_FEATURE_AVX512F },
+        { ELPA_2STAGE_REAL_AVX2_BLOCK2,   CPU_FEATURE_AVX2 },
+        { ELPA_2STAGE_REAL_AVX2_BLOCK4,   CPU_FEATURE_AVX2 },
+        { ELPA_2STAGE_REAL_AVX2_BLOCK6,   CPU_FEATURE_AVX2 },
+        { ELPA_2STAGE_REAL_AVX_BLOCK2,    CPU_FEATURE_AVX },
+        { ELPA_2STAGE_REAL_AVX_BLOCK4,    CPU_FEATURE_AVX },
+        { ELPA_2STAGE_REAL_AVX_BLOCK6,    CPU_FEATURE_AVX },
+        { ELPA_2STAGE_REAL_SSE_BLOCK2,    CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_REAL_SSE_BLOCK4,    CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_REAL_SSE_BLOCK6,    CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_REAL_SSE_ASSEMBLY,  CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_REAL_GENERIC,       CPU_FEATURE_NONE },
+        { ELPA_2STAGE_REAL_GENERIC_SIMPLE, CPU_FEATURE_NONE },
+        { ELPA_2STAGE_REAL_GENERIC_SIMPLE_BLOCK4, CPU_FEATURE_NONE },
+        { ELPA_2STAGE_REAL_GENERIC_SIMPLE_BLOCK6, CPU_FEATURE_NONE },
+};
+
+static const struct kernel_probe complex_kernel_probe_order[] = {
+        { ELPA_2STAGE_COMPLEX_AVX512_BLOCK1, CPU_FEATURE_AVX512F },
+        { ELPA_2STAGE_COMPLEX_AVX512_BLOCK2, CPU_FEATURE_AVX512F },
+        { ELPA_2STAGE_COMPLEX_AVX2_BLOCK1,   CPU_FEATURE_AVX2 },
+        { ELPA_2STAGE_COMPLEX_AVX2_BLOCK2,   CPU_FEATURE_AVX2 },
+        { ELPA_2STAGE_COMPLEX_AVX_BLOCK1,    CPU_FEATURE_AVX },
+        { ELPA_2STAGE_COMPLEX_AVX_BLOCK2,    CPU_FEATURE_AVX },
+        { ELPA_2STAGE_COMPLEX_SSE_BLOCK1,    CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_COMPLEX_SSE_BLOCK2,    CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_COMPLEX_SSE_ASSEMBLY,  CPU_FEATURE_SSE2 },
+        { ELPA_2STAGE_COMPLEX_GENERIC,       CPU_FEATURE_NONE },
+        { ELPA_2STAGE_COMPLEX_GENERIC_SIMPLE, CPU_FEATURE_NONE },
+};
+
+/* Kernel values are positive; -1 means nothing matched */
+static int autodetect_kernel(const struct kernel_probe *order, int nentries,
+                int (*is_compiled)(int)) {
+        for (int i = 0; i < nentries; i++) {
+                if (!is_compiled(order[i].kernel))
+                        continue;
+                if (!cpu_feature_supported(order[i].cpu_feature))
+                        continue;
+                return order[i].kernel;
+        }
+        return -1;
+}
+
+static void autodetect_default_kernel(elpa_index_t index, char *option, int detected) {
+        int n = find_int_entry(option);
+        if (n < 0 || detected < 0)
+                return;
+        if (index->int_options.notified[n] & NOTIFY_ENV_DEFAULT)
+                return;
+        index->int_options.values[n] = detected;
+        if (elpa_index_get_int_value(index, "verbose", NULL)) {
+                const char *value_string = NULL;
+                if (elpa_int_value_to_string(option, detected, &value_string) == ELPA_OK \
+                                && value_string != NULL) {
+                        fprintf(stderr, "ELPA: Default for option '%s' is set to %s by runtime CPU detection\n",
+                                        option, value_string);
+                }
+        }
+}
+
+#endif /* x86 */
+
+static void autodetect_default_kernels(elpa_index_t index) {
+#if defined(__x86_64__) || defined(__i386__)
+        autodetect_default_kernel(index, "real_kernel",
+                        autodetect_kernel(real_kernel_probe_order, nelements(real_kernel_probe_order),
+                                        real_kernel_is_compiled));
+        autodetect_default_kernel(index, "complex_kernel",
+                        autodetect_kernel(complex_kernel_probe_order, nelements(complex_kernel_probe_order),
+                                        complex_kernel_is_compiled));
+#else
+        (void) index;
+#endif
+}
+
 static const char* elpa_autotune_level_name(int level) {
         switch(level) {
                 ELPA_FOR_ALL_AUTOTUNE_LEVELS(NAME_CASE)
@@ -1600,6 +1740,8 @@ elpa_index_t elpa_index_instance() {
 
         FOR_ALL_TYPES(ALLOCATE)
 
+        autodetect_default_kernels(index);
+
         return index;
 }
 
